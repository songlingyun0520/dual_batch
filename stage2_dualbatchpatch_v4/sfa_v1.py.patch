+def _slice_decode_metadata(md: M, lo: int, hi: int) -> M:
+    """Slice requests, retaining physical cache addresses and device metadata.
+
+    Only uniform, one-query-token-per-request DecodeOnly is supported. The
+    split is based on graph capacity, NEVER num_actual_tokens/seq_lens values.
+    CPU counts below are descriptive at capture time; kernels use device
+    seq_lens/cum_query_lens, which the runner updates before every replay.
+    """
+    group = copy.copy(md)
+    group.num_input_tokens = hi - lo
+    group.num_actual_tokens = max(0, min(md.num_actual_tokens - lo, hi - lo))
+    group.num_decodes = group.num_actual_tokens
+    group.num_decode_tokens = group.num_actual_tokens
+    group.num_prefills = 0
+    for name in ("slot_mapping", "seq_lens", "block_table", "cos", "sin"):
+        setattr(group, name, getattr(md, name)[lo:hi])
+    group.seq_lens_cpu = None if md.seq_lens_cpu is None else md.seq_lens_cpu[lo:hi]
+    offsets = md.cum_query_lens[lo:hi]
+    # NPU subtraction is captured and recomputed during replay; never .item().
+    group.cum_query_lens = offsets if lo == 0 else offsets - md.cum_query_lens[lo - 1]
+    return group
+
+
+def _is_compact_dp_decode_layout(md: M) -> bool:
+    """Recognize token padding with compact, internally consistent request rows.
+
+    DP coordination may enlarge num_input_tokens while this DP still has only
+    one query per real request. When dispatch falls back to NONE, the runner
+    keeps request metadata compact. Such a step must use the original unsplit
+    path. This predicate reads host counts/shapes only, never device values.
+    """
+    n = md.num_input_tokens
+    rows = md.seq_lens.shape[0]
+    return (
+        0 <= md.num_actual_tokens <= rows < n
+        and md.cum_query_lens.shape[0] == rows
+        and md.block_table.shape[0] == rows
+        and all(getattr(md, name).shape[0] == n
+                for name in ("slot_mapping", "cos", "sin"))
+    )
+
+
+def _validate_dual_decode_layout(md: M, hidden_states: torch.Tensor) -> None:
+    """Reject unsupported layouts explicitly instead of silently disabling split.
+
+    FULL_DECODE_ONLY uses padded request rows for padded query rows. FULL mixed
+    graphs may use one dummy request covering multiple query tokens and are not
+    supported here. Only tensor shapes are inspected; no device-to-host reads.
+    """
+    n = md.num_input_tokens
+    if n < 1:
+        raise RuntimeError("SFA dual decode requires positive graph capacity")
+    tensors = {"hidden_states": hidden_states}
+    for name in ("slot_mapping", "seq_lens", "cum_query_lens", "block_table", "cos", "sin"):
+        tensors[name] = getattr(md, name)
+    wrong = [name for name, tensor in tensors.items() if tensor.shape[0] != n]
+    if wrong:
+        raise RuntimeError(
+            "SFA dual decode requires one request row per query token, including graph padding; "
+            f"capacity={n}, mismatched tensors={wrong}. Use FULL_DECODE_ONLY without MTP/CP."
+        )
 
 
